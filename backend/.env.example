# WareFlow
APP_NAME=WareFlow
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://wareflow:wareflow@db:5432/wareflow
DATABASE_URL_SYNC=postgresql://wareflow:wareflow@db:5432/wareflow

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-in-production-use-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:3000"]
